# ==========================================
# Root .gitignore for Vertex Microservices
# ==========================================

# ------------------------------------------
# Gradle & Java Build Artifacts
# ------------------------------------------
.gradle/
**/.gradle/
build/
**/build/
target/
**/target/
out/
**/out/
bin/
**/bin/

# Do not ignore gradle wrapper
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar

# ------------------------------------------
# Node & Frontend (Vaadin / Vite / React)
# ------------------------------------------
node_modules/
**/node_modules/
node/
**/node/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnpm-store/
package-lock.json
**/package-lock.json
pnpm-lock.yaml
**/pnpm-lock.yaml

# Vaadin frontend generated files & precompiled bundles
**/src/main/frontend/generated/
**/src/main/bundles/
**/vite.generated.ts
vite.generated.ts
pnpmfile.js
drivers/
error-screenshots/

# ------------------------------------------
# IDEs & Editors
# ------------------------------------------
# IntelliJ IDEA
.idea/
**/.idea/
*.iml
**/*.iml
*.iws
*.ipr
.idea_modules/

# Visual Studio Code
.vscode/
**/.vscode/

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# NetBeans
**/nbproject/private/
**/nbbuild/
**/dist/
**/nbdist/
**/.nb-gradle/

# ------------------------------------------
# Environment & Secrets
# ------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------
# OS & System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------
# Logs & Temp Files
# ------------------------------------------
*.log
logs/
**/logs/
*.tmp
*.bak
*.swp
*.swo
*~
HELP.md
